# Environment Variables
NODE_ENV=development
PORT=5000

# MongoDB (replace with your MongoDB URI)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# JWT (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Dedicated secret for AES-256-GCM encryption of public share bearer tokens (Mandatory in production)
# Generate with: openssl rand -hex 32
SHARE_TOKEN_SECRET=your-32-byte-hex-share-encryption-secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Express Reverse Proxy Trust (1 for single reverse proxy like Render, or hop count)
TRUST_PROXY=1

# Admin Defaults (for seeding - change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
FIRM_NAME=Your Firm Name

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Set this while creating the Razorpay webhook in the Dashboard.
# It is not a third API key; it is the webhook signing secret used to verify X-Razorpay-Signature.
RAZORPAY_WEBHOOK_SECRET=choose-a-strong-webhook-signing-secret
RAZORPAY_SUBSCRIPTION_MAX_YEARS=10
